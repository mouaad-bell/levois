{
  "name": "levois-fr-production",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','out']) fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "npm run clean && next build",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run validate:routes && npm run validate:editorial && npm run validate:render && npm run validate:carousel-exports && npm run validate:dependencies && npm run validate:pilot-evidence && npm run validate:pilot-packages && npm run validate:answers && npm run validate:article-public && npm run test:evidence-import && npm run test:d1-schema && npm run build && npm run security:audit",
    "deploy": "wrangler deploy",
    "validate:routes": "node scripts/validate-route-authority.mjs",
    "validate:editorial": "node scripts/validate-editorial-pilots.mjs",
    "validate:render": "node scripts/validate-render-packages.mjs",
    "validate:carousel-exports": "node scripts/validate-carousel-exports.mjs",
    "test:evidence-import": "node scripts/test-evidence-import-limits.mjs",
    "validate:dependencies": "node scripts/validate-content-dependencies.mjs",
    "validate:answers": "node scripts/validate-answers-pilots.mjs",
    "validate:article-public": "node scripts/validate-article-public-contract.mjs",
    "validate:pilot-evidence": "node scripts/validate-pilot-evidence-snapshot.mjs",
    "test:d1-schema": "python3 scripts/test-d1-schema.py",
    "export:pilots": "node scripts/export-pilot-packages.mjs",
    "export:carousels": "node scripts/export-carousel-pngs.mjs",
    "validate:pilot-packages": "node scripts/export-pilot-packages.mjs --output .tmp-pilot-packages"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
