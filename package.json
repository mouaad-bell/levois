{
  "name": "levois-fr-production",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['.next','out']) fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "npm run clean && next build",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run validate:editorial && npm run build && npm run security:audit",
    "deploy": "wrangler deploy",
    "validate:editorial": "node scripts/validate-editorial-pilots.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
