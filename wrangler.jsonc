{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "levois",
  "main": "worker.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/studio/*"
    ],
    "not_found_handling": "404-page"
  },
  "env": {
    "studio": {
      "name": "levois-studio",
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
